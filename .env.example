# Copy to `.env.local` (not committed) and fill in.

# Public URL of the deployed site, no trailing slash. Used for canonical, OG tags, robots.txt and sitemap.xml.
VITE_SITE_URL=https://www.example.com

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Leave empty to disable tracking.
VITE_GA_ID=

# Google Apps Script web-app URL that saves reservations to Google Sheets (see apps-script/Code.gs).
VITE_SHEETS_ENDPOINT=
